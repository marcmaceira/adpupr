# Generate a local database password: openssl rand -hex 16
# Put that same value in LOCAL_POSTGRES_PASSWORD and DATABASE_URL below.
# The Docker user is adpupr; the database listens only on loopback.
LOCAL_POSTGRES_PASSWORD=
DATABASE_URL=postgres://adpupr:LOCAL_DB_PASSWORD@127.0.0.1:54329/adpupr

# Generate a stable signing secret: openssl rand -hex 32
PAYLOAD_SECRET=

# This machine's private preview URL; change for your own development machine.
NEXT_PUBLIC_SITE_URL=http://192.168.9.4:3002

# Leave empty locally: uploads use ./uploads. Required on Vercel.
BLOB_READ_WRITE_TOKEN=

# Local development uses schema push. Deployed databases must set this to false.
# PAYLOAD_DB_PUSH=false

# One-off seed/import safety opt-in for approved remote database or Blob writes.
# Do not set globally by default.
# CMS_ALLOW_REMOTE_WRITES=true
